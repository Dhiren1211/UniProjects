generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// ============================================================
// UniProjects - FULL platform for a SINGLE university.
// The university itself is app-level config (src/lib/config.ts).
// ============================================================

// ---------- Identity & Auth ----------
// Role hierarchy (highest → lowest): ADMIN | MODERATOR | PROFESSOR | STUDENT.
// VISITOR = unauthenticated (no User row).

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  displayName         String
  email               String    @unique
  passwordHash        String
  emailVerified       Boolean   @default(false) // true for accounts provisioned by admin approval
  emailVerifiedAt     DateTime?
  role                String    @default("STUDENT") // ADMIN | MODERATOR | PROFESSOR | STUDENT
  studentId           String?   @unique // university student number - also the login userID for students
  classId             String? // e.g. "CD2-2025-KIM" - students sharing a classId form one section
  capstone            String? // "I" | "II" | "III"
  cohortYear          Int? // capstone course year (e.g. 2025)
  professorName       String? // professor responsible for the student's section
  isTeamLeader        Boolean   @default(false) // only team leaders may submit projects
  bio                 String?
  avatarUrl           String?
  program             String? // major / program
  skills              String? // comma separated
  website             String?
  github              String?
  universityProfileUrl String? // PROFESSOR only - link to the faculty member's official university profile page
  lookingForTeammates Boolean   @default(false)
  departmentId        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  department       Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessions         Session[]
  ownedProjects    Project[]       @relation("ProjectOwner")
  memberships      ProjectMember[]
  comments         Comment[]
  likes            Like[]
  bookmarks        Bookmark[]
  followsGiven     Follow[]        @relation("Follower")
  joinRequests     JoinRequest[]
  notifications    Notification[]
  reportsFiled     Report[]        @relation("Reporter")
  verificationsReq Verification[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Students cannot self-register. They submit an AccountRequest; an admin
// approves it, the backend provisions credentials and emails them to the
// derived university address (<studentId>@ks.ac.kr).
model AccountRequest {
  id            String    @id @default(cuid())
  role          String    @default("STUDENT") // STUDENT | PROFESSOR
  studentId     String?   @unique // students only
  email         String?   @unique // professors only - students use a<studentId>@ks.ac.kr
  name          String
  capstone      String? // "I" | "II" | "III" - students only
  year          Int? // capstone course year - students only
  professor     String? // students only
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decisionNote  String?
  classId       String? // finalized at approval time
  decidedAt     DateTime?
  decidedBy     String?
  createdUserId String? // User provisioned by the approval
  createdAt     DateTime  @default(now())
}

// Simple DB-backed key/value store driving admin-configurable behaviour
// (search bar toggle, hero copy, account-request intake, …).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Outbox for transactional email. In this sandbox there is no SMTP host,
// so messages are persisted here (status CONSOLE) and mirrored to the server
// log; src/lib/mailer.ts upgrades to real delivery when SMTP env vars exist.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  kind      String   @default("SYSTEM") // CREDENTIALS | SYSTEM
  status    String   @default("CONSOLE") // SENT | FAILED | CONSOLE (stored only, SMTP not configured)
  createdAt DateTime @default(now())
}

model PasswordResetRequest {
  id        String   @id @default(cuid())
  email     String // the university address the requester typed
  userId    String? // set when the email matched a registered account
  status    String   @default("PENDING") // PENDING = waiting for admin | SENT = new password emailed | NOT_FOUND
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Department {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  tagline       String?
  website       String? // official department homepage (kscms.ks.ac.kr/…) - editable in the admin panel
  capstoneLabel String    @default("Capstone Design") // what this faculty calls its capstone course (default: Global IT's "Capstone Design")
  accent        String    @default("emerald")
  sortOrder     Int       @default(0)
  projects      Project[]
  users         User[]
}

// ---------- Projects ----------

model Project {
  id                  String     @id @default(cuid())
  slug                String     @unique
  title               String
  summary             String
  description         String
  coverImage          String? // path under /public (e.g. /covers/terrabot.webp)
  category            String // AI & ML | Web & App | IoT & Hardware | Data & Analytics | Design & Media | Security
  year                Int
  semester            String     @default("Spring")
  program             String?
  supervisor          String?
  departmentId        String
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  ownerId             String?
  owner               User?      @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  classId             String? // denormalised from the owner's classId at submission time
  status              String     @default("DRAFT") // DRAFT | PENDING (waiting for approval) | PUBLISHED | REJECTED (changes requested)
  reviewNote          String? // reviewer's note when changes are requested
  submittedAt         DateTime? // last time the team sent it for approval
  reviewedAt          DateTime?
  reviewedById        String?
  allowJoinRequests   Boolean    @default(true)
  lookingForTeammates Boolean    @default(false)
  verified            Boolean    @default(false)
  tags                String     @default("")
  demoUrl             String?
  repoUrl             String?
  featured            Boolean    @default(false)
  views               Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  members       ProjectMember[]
  technologies  ProjectTechnology[]
  resources     ProjectResource[]
  images        ProjectImage[]
  timeline      ProjectTimeline[]
  comments      Comment[]
  joinRequests  JoinRequest[]
  verifications Verification[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // OWNER | LEAD | MEMBER
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
}

model Technology {
  id       String              @id @default(cuid())
  name     String              @unique
  slug     String              @unique
  category String              @default("Other")
  projects ProjectTechnology[]
}

model ProjectTechnology {
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([projectId, technologyId])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

model ProjectResource {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // DEMO | GITHUB | DOCUMENT | VIDEO | PRESENTATION
  label     String
  url       String // https://… link OR /uploads/... path for uploaded files
  createdAt DateTime @default(now())
}

model ProjectTimeline {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  note      String?
}

// ---------- Community ----------

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // POST | PROJECT
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // PROJECT | POST
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  targetType String // USER | PROJECT
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([followerId, targetType, targetId])
}

model JoinRequest {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Verification {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // PROJECT | POST | USER
  targetId   String
  reason     String
  status     String   @default("OPEN") // OPEN | RESOLVED
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // JOIN_REQUEST | JOIN_APPROVED | JOIN_REJECTED | VERIFICATION | COMMENT | FOLLOW | LIKE | CREDENTIALS | SYSTEM
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Uploaded files (avatars, covers, gallery, hero, resources). Stored in the database
// because serverless hosts (Vercel) have a read-only, ephemeral filesystem.
// Served at /uploads/<name> via a rewrite to /api/files/<name>.
model UploadedFile {
  id         String   @id @default(cuid())
  name       String   @unique // e.g. "hero-mv1c5ix4-4f168908e8.jpg"
  mime       String
  size       Int
  data       Bytes
  kind       String // avatar | cover | gallery | resource | hero
  compressed Boolean  @default(false) // already re-encoded by the image compressor
  uploaderId String?
  createdAt  DateTime @default(now())
}

// Fixed-window rate limiting (login, password resets, account requests).
// Stored in the database because serverless instances share no memory.
model RateLimit {
  key     String   @id // e.g. "login:ip:1.2.3.4"
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// Audit trail of staff actions (approvals, resets, deletions, settings …).
// Names are copied in so the log still reads well after a user is deleted.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String
  action      String // e.g. "user.delete", "project.approve", "password.reset"
  targetType  String // USER | PROJECT | REQUEST | ANNOUNCEMENT | DEPARTMENT | SETTINGS | REPORT | VERIFICATION
  targetId    String?
  targetLabel String
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
