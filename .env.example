# Copy to .env and fill in. Never commit the real .env.

# Neon / Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Outgoing email (optional - without these, mail is only stored in Admin → Emails).
# Use a dedicated Gmail account for the site, NOT your personal address.
# SMTP_PASS is a Gmail "App Password" (Google Account → Security → App passwords).
SMTP_USER="your-site-account@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM_NAME="Capstone Contest"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# First admin created by `bun prisma/seed.ts` (seed WIPES all data)
# ADMIN_USERNAME="admin.username"
# ADMIN_NAME="Admin Name"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""
